{
  "name": "redux-retry",
  "version": "1.0.0",
  "description": "Redux retry for easy state management of async calls",
  "main": "./dist/index.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimeshgurung/redux-retry.git"
  },
  "bugs": {
    "url": "https://github.com/nimeshgurung/redux-retry/issues"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:compat": "node scripts/compat.mjs",
    "test:live": "playwright test --config playwright.live.config.ts",
    "lint": "eslint src tests scripts *.ts *.mjs",
    "format:check": "prettier --check src tests scripts examples *.ts *.mjs package.json tsconfig.json README.md CHANGELOG.md .github docs/index.html",
    "tsc:check": "tsc --noEmit",
    "check:package": "publint && attw --pack --profile node16",
    "verify": "npm run lint && npm test && npm run tsc:check && npm run check:package",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "pretest:e2e": "npm run build",
    "pretest:live": "npm run build"
  },
  "author": "Nimesh Gurung",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.0",
    "@reduxjs/toolkit": "2.14.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^27.0.0",
    "metro": "0.88.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "redux": "5.0.1",
    "redux-saga": "1.5.1",
    "redux-thunk": "3.1.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-redux": "^9.0.0",
    "redux": "^5.0.0",
    "redux-saga": "^1.0.0",
    "redux-thunk": "^3.1.0"
  },
  "keywords": [
    "react",
    "redux",
    "react-redux",
    "redux-saga",
    "redux-retry"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "llm.text",
    "llms.txt",
    "CHANGELOG.md",
    "assets/logos/blue-nodes.png"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./saga": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./thunk": {
      "import": {
        "types": "./dist/thunk.d.ts",
        "default": "./dist/thunk.js"
      },
      "require": {
        "types": "./dist/thunk.d.cts",
        "default": "./dist/thunk.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "redux-saga": {
      "optional": true
    },
    "redux-thunk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
